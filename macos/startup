#!/bin/bash

# 1. Détection robuste du dossier de l'application (peu importe d'où elle est lancée)
EXEC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(dirname "$(dirname "$EXEC_DIR")")"

# 2. Définition des variables d'environnement cruciales
export OZHOME="$APP_ROOT/Contents/Resources"
# On ajoute les binaires (oz, ozc, ozwish) au PATH pour qu'Aquamacs les trouve !
export PATH="$OZHOME/bin:$PATH"

# 3. Recherche de l'interface graphique (Aquamacs ou Emacs standard)
AQUAMACS="/Applications/Aquamacs.app/Contents/MacOS/Aquamacs"
EMACS="/Applications/Emacs.app/Contents/MacOS/Emacs"
OPIEMACS=""

if [ -f "$AQUAMACS" ]; then
  OPIEMACS="$AQUAMACS"
elif [ -f "$EMACS" ]; then
  OPIEMACS="$EMACS"
fi

# 4. Lancement ou Message d'erreur
if [ -z "$OPIEMACS" ]; then
  # Fait apparaître une jolie fenêtre d'erreur native macOS avec un bouton OK
  osascript -e 'tell application "Finder"' -e 'display dialog "Aquamacs est introuvable sur ce Mac.\n\nVeuillez télécharger Aquamacs (http://aquamacs.org/) et le glisser dans votre dossier Applications pour utiliser l'\''interface de Mozart 2." with title "Dépendance manquante" buttons {"OK"} default button "OK" with icon stop' -e 'end tell'
else
  # Lance Aquamacs en lui injectant le code Elisp de Mozart
  "$OPIEMACS" --eval "(setq load-path (cons \"$OZHOME/share/mozart/elisp\" load-path))" -l oz.elc -f run-oz "$@" &
fi